{
  "name": "vibesai-openai",
  "version": "1.0.0",
  "description": "OpenAI-compatible REST API for vibes.ai — TypeScript, deployable free on Cloudflare Workers, Node, Deno, Bun, or Docker.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "start:node": "tsx src/node.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/smoke.ts",
    "test:routes": "tsx test/verify-fix.ts",
    "test:drm": "tsx test/drm-vectors.ts"
  },
  "keywords": [
    "vibes.ai",
    "openai",
    "openai-compatible",
    "cloudflare-workers",
    "video-generation",
    "tts",
    "hono"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@types/ws": "^8.18.2",
    "hono": "^4.6.14",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "@hono/node-server": "^1.13.7",
    "@types/node": "^22.10.2",
    "openai": "^7.53.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}