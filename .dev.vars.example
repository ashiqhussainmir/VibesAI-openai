# Local development secrets — copy to `.dev.vars` and fill in.
# NEVER commit the real .dev.vars file (it's gitignored).
#
# Full step-by-step guide for BOTH cookies: COOKIES.md

# --- Required -----------------------------------------------------------
# Your vibes.ai `meta_session` cookie — the server-side vibes session.
# Get it: DevTools (F12) → Application → Cookies → https://vibes.ai
#         → copy the VALUE of the row named "meta_session".
# Format: one long token like "e60e910a-242a-....fGg" (UUID + dot + signature).
VIBES_META_SESSION=""

# --- Optional -----------------------------------------------------------
# If set, clients must send THIS value as Bearer token
# instead of the raw vibes cookie.
VIBES_API_KEY=""

# auth.meta.com cookie string — enables automatic re-login when the vibes
# session expires (~30 min idle). Easiest way to get it: DevTools → Network
# tab → click any auth.meta.com request → Request Headers → Cookie →
# copy the whole value. Format: "name=value; name=value; ..."
# Example: "ps_n=1; ps_l=1; datr=Bxxx...; fs=1; locale=en_GB"
# Setting it automatically enables auto re-login (no other flag needed).
AUTH_META_COOKIES=""
